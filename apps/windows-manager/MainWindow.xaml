<Window x:Class="ReimsManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReimsManager"
 Title="Reims — 仮想マシン" Width="1280" Height="860" MinWidth="1040" MinHeight="720"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Yu Gothic UI" FontSize="14">
 <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Menu Padding="12,4">
   <MenuItem Header="ファイル"><MenuItem Header="新しい仮想マシン…" Click="NewVm"/><MenuItem Header="仮想マシンを開く…" Click="OpenVm"/><MenuItem Header="既存のディスクを取り込む…" Click="ImportVm"/><Separator/><MenuItem Header="VM の保存先を開く" Click="RevealVm"/></MenuItem>
   <MenuItem Header="仮想マシン"><MenuItem Header="起動" Tag="Start" Click="MenuAction"/><MenuItem Header="シャットダウン" Tag="PowerOff" Click="MenuAction"/><MenuItem Header="再起動" Tag="Restart" Click="MenuAction"/><Separator/><MenuItem Header="強制終了…" Click="ForceExit"/></MenuItem>
   <MenuItem Header="表示"><MenuItem Header="VM 画面を別ウィンドウにする" Click="PopOutConsole"/><MenuItem Header="VM 画面をアプリに戻す" Click="DockConsole"/></MenuItem>
  </Menu>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,1,0" Padding="16,20,12,16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Reims" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="仮想マシン" Style="{StaticResource MutedText}" Margin="0,24,0,10"/>
      <WrapPanel><Button Content="新規" Click="NewVm"/><Button Content="開く" Click="OpenVm"/></WrapPanel></StackPanel>
     <ListBox x:Name="Library" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="VmChanged" Margin="0,8,0,16">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0,0,0,8"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="macOS" Style="{StaticResource MutedText}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Expander Grid.Row="2" Header="エンジンの場所"><StackPanel Margin="0,12,0,0"><TextBox x:Name="Root" TextWrapping="Wrap"/><Button Content="フォルダーを選択…" Click="BrowseRoot" Margin="0,8,0,0"/></StackPanel></Expander>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="24,16,24,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="VmTitle" Text="仮想マシンを選択" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="State" Text="状態を取得しています…" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
     <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="&#x25B6;  起動" Tag="Start" Click="ActionClick" Style="{StaticResource PrimaryButton}"/><Button Content="電源オフ" Tag="PowerOff" Click="ActionClick"/><Button Content="再起動" Tag="Restart" Click="ActionClick"/>
      <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" ToolTip="その他の電源操作" Click="ShowPowerMenu"><Button.ContextMenu><ContextMenu><MenuItem Header="完全終了（設定変更前）" Tag="Exit" Click="MenuAction"/><MenuItem Header="一時停止" Tag="Pause" Click="MenuAction"/><MenuItem Header="再開" Tag="Resume" Click="MenuAction"/><Separator/><MenuItem Header="強制終了…" Click="ForceExit"/></ContextMenu></Button.ContextMenu></Button></WrapPanel>
    </Grid>
    <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="TabChanged">
     <TabItem Header="画面"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
       <Grid><StackPanel x:Name="ConsolePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Margin="32"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="56" HorizontalAlignment="Center"/><TextBlock Text="ここに VM の画面が表示されます" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,10"/><TextBlock Text="起動すると、このアプリ内で macOS を操作できます。" TextAlignment="Center" Style="{StaticResource MutedText}"/><Button Content="画面を接続" Click="DockConsole" HorizontalAlignment="Center" Margin="0,20,0,0"/></StackPanel>
        <local:VmConsoleHost x:Name="ConsoleView" Visibility="Hidden"/>
       </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="入力の解放: Ctrl + Alt + Win" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="別ウィンドウで開く" Click="PopOutConsole" Margin="0"/>
      </Grid>
     </Grid></TabItem>
     <TabItem Header="設定"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="202"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="Devices" SelectionChanged="DeviceChanged" BorderThickness="0" Background="Transparent">
       <ListBoxItem>メモリ</ListBoxItem><ListBoxItem>プロセッサ</ListBoxItem><ListBoxItem>ハードディスク</ListBoxItem><ListBoxItem>CD/DVD・ISO</ListBoxItem><ListBoxItem>ネットワーク</ListBoxItem><ListBoxItem>USB デバイス</ListBoxItem><ListBoxItem>マイク・スピーカー</ListBoxItem><ListBoxItem>ディスプレイ</ListBoxItem>
      </ListBox>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Grid x:Name="Editors" Margin="0,4,12,16">
       <StackPanel x:Name="MemoryPage"><TextBlock Text="メモリ" Style="{StaticResource PageHeading}"/><TextBlock Text="macOS に割り当てるメモリを選びます。" Style="{StaticResource MutedText}"/><TextBlock Text="割り当て容量 (MiB)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Memory" Text="8192" Width="180" HorizontalAlignment="Left"/>
        <Slider x:Name="MemorySlider" Minimum="4" Maximum="64" Value="8" TickFrequency="4" ValueChanged="MemoryChanged" Margin="0,24,0,8"/><DockPanel><TextBlock Text="4 GiB"/><TextBlock Text="64 GiB" TextAlignment="Right"/></DockPanel><TextBlock x:Name="MemoryHint" Style="{StaticResource MutedText}" Margin="0,24,0,0" Text="ホストの空きメモリを残して設定してください。"/></StackPanel>
       <StackPanel x:Name="CpuPage" Visibility="Collapsed"><TextBlock Text="プロセッサ" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows のハードウェア仮想化を使用します。" Style="{StaticResource MutedText}"/><TextBlock Text="CPU コア数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Cpus" Text="8" Width="180" HorizontalAlignment="Left"/><TextBlock Text="1 ソケット / Windows Hypervisor Platform" Style="{StaticResource MutedText}" Margin="0,24,0,0"/></StackPanel>
       <StackPanel x:Name="DiskPage" Visibility="Collapsed"><TextBlock Text="ハードディスク" Style="{StaticResource PageHeading}"/><TextBlock x:Name="DiskInfo" TextWrapping="Wrap" Margin="0,8,0,16"/><WrapPanel><Button Content="保存先を開く" Click="RevealVm"/><Button Content="ディスク差分を整理" Tag="OptimizeDisk" Click="ActionClick"/></WrapPanel><TextBlock Text="拡張後の容量 (GiB)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DiskSize" Text="128" Width="180" HorizontalAlignment="Left"/><Button Content="容量を拡張…" Click="ExpandDisk" HorizontalAlignment="Left" Margin="0,16,0,8"/><TextBlock Text="拡張後、macOS の Disk Utility でも APFS 領域を拡張します。" Style="{StaticResource MutedText}"/></StackPanel>
       <StackPanel x:Name="MediaPage" Visibility="Collapsed"><TextBlock Text="CD/DVD・ISO" Style="{StaticResource PageHeading}"/><CheckBox x:Name="HardwareIso" Content="起動時にインストーラーを接続" Margin="0,18,0,16"/><TextBox x:Name="HardwareIsoPath"/><Button Content="ISO を選択…" Click="BrowseHardwareIso" HorizontalAlignment="Left" Margin="0,16,0,8"/><TextBlock Text="インストールが終わったら接続を解除できます。" Style="{StaticResource MutedText}"/></StackPanel>
       <StackPanel x:Name="NetworkPage" Visibility="Collapsed"><TextBlock Text="ネットワーク" Style="{StaticResource PageHeading}"/><RadioButton x:Name="Nat" Content="NAT（通常はこちら）" IsChecked="True" Margin="0,18,0,6"/><TextBlock Text="Windows のインターネット接続を共有します。Apple Account も使用できます。" Style="{StaticResource MutedText}" Margin="24,0,0,20"/><RadioButton x:Name="Bridge" Content="ブリッジ" Margin="0,0,0,6"/><TextBlock Text="VM を LAN 上の独立した機器として接続します。" Style="{StaticResource MutedText}" Margin="24,0,0,8"/><TextBlock Text="TAP アダプター" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Tap"/><TextBlock Text="macOS の IP アドレス / ホスト名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GuestHost"/><Button Content="ブリッジの準備" Click="OpenBridgeTab" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
       <StackPanel x:Name="UsbPage" Visibility="Collapsed"><TextBlock Text="USB デバイス" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows に接続したデバイスを、この VM に接続します。接続中は Windows 側から使用できません。" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,18,0,12"><Button Content="デバイス一覧を更新" Click="RefreshUsb"/><Button Content="USB 転送ドライバーを導入…" Click="InstallUsbDk"/></WrapPanel><ListBox x:Name="UsbDevices" MinHeight="140" MaxHeight="280" DisplayMemberPath="Label"/><WrapPanel Margin="0,12,0,0"><Button Content="自動接続に登録" Click="AttachUsb"/><Button Content="登録を解除して Windows に戻す" Click="DetachUsb"/></WrapPanel><TextBlock Text="転送方式（変更は次回起動時）" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UsbBackend" SelectedIndex="0"><ComboBoxItem>WinUSB（対応する機器）</ComboBoxItem><ComboBoxItem>UsbDk（汎用転送・ドライバー導入後）</ComboBoxItem></ComboBox><TextBlock x:Name="UsbHint" Style="{StaticResource MutedText}" Text="USB 転送には Windows 側の対応ドライバーが必要です。"/></StackPanel>
       <StackPanel x:Name="AudioPage" Visibility="Collapsed"><TextBlock Text="マイク・スピーカー" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows の標準デバイスを macOS と共有します。" Style="{StaticResource MutedText}"/><CheckBox x:Name="Sound" Content="スピーカーを共有" Margin="0,24,0,16"/><CheckBox x:Name="Microphone" Content="マイクを共有" Margin="0,0,0,20"/><TextBlock Text="マイクは macOS のアプリが録音を開始したときに使用します。Windows と macOS の両方でマイクの使用許可を確認してください。" Style="{StaticResource MutedText}"/><Button Content="Windows のサウンド設定" Click="OpenSoundSettings" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel>
       <StackPanel x:Name="DisplayPage" Visibility="Collapsed"><TextBlock Text="ディスプレイ" Style="{StaticResource PageHeading}"/><TextBlock Text="起動時の解像度" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Resolution"><ComboBoxItem>1280x720</ComboBoxItem><ComboBoxItem IsSelected="True">1920x1080</ComboBoxItem><ComboBoxItem>2560x1440</ComboBoxItem><ComboBoxItem>3840x2160</ComboBoxItem></ComboBox><Button Content="実行中の macOS に適用" Click="ApplyResolution" HorizontalAlignment="Left" Margin="0,18,0,0"/><TextBlock Text="macOS 26 の Intel VM では、画面幅が 2048 ピクセルを超えると表示が乱れる既知の問題があります。安定した操作には 1920 × 1080 を推奨します。4K は描画負荷も高くなります。" Style="{StaticResource MutedText}" Margin="0,20,0,0"/><TextBlock Text="Reims vGPU · Apple Paravirtualized Graphics" Style="{StaticResource MutedText}" Margin="0,24,0,0"/></StackPanel>
      </Grid></ScrollViewer>
      <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,18,0,0"><Button Content="設定を保存" DockPanel.Dock="Right" Click="SaveHardware" Style="{StaticResource PrimaryButton}"/><Button Content="変更を取り消す" DockPanel.Dock="Right" Click="ReloadHardware"/><TextBlock Text="変更は VM の完全終了後に保存できます。" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></DockPanel>
     </Grid></TabItem>
     <TabItem Header="共有"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,20,20" MaxWidth="680" HorizontalAlignment="Left">
      <TextBlock Text="クリップボード" Style="{StaticResource PageHeading}"/><TextBlock Text="Windows と macOS の間でテキストをコピー＆ペーストできます。" Style="{StaticResource MutedText}"/>
      <CheckBox x:Name="ClipboardSharing" Content="テキストを自動で共有する" Checked="ClipboardChanged" Unchecked="ClipboardChanged" Margin="0,24,0,12"/>
      <TextBlock Text="このアプリの起動中、選択した VM と共有します。画像・ファイルは対象外です。" Style="{StaticResource MutedText}"/>
      <WrapPanel Margin="0,24,0,0"><Button Content="Windows → macOS" Click="CopyToGuest"/><Button Content="macOS → Windows" Click="CopyFromGuest"/></WrapPanel><TextBlock x:Name="ClipboardStatus" Text="自動共有はオフです。" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
      <TextBlock Text="接続について" Style="{StaticResource SectionHeading}"/><TextBlock Text="共有には SSH のペアリングが必要です。コピー内容をファイルやログには保存しません。" Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="OpenCore"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,20,20" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="Mac の識別情報" Style="{StaticResource PageHeading}"/><TextBlock Text="Apple Account にログイン済みの場合、識別情報を変更すると再認証が必要になることがあります。" Style="{StaticResource MutedText}"/>
      <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="モデル"/><TextBox x:Name="IdentityModel" Margin="0,6,0,14"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="シリアル番号"/><TextBox x:Name="IdentitySerial" Margin="0,6,0,14"/></StackPanel>
       <StackPanel Grid.Row="1"><TextBlock Text="MLB（ボードシリアル）"/><TextBox x:Name="IdentityMlb" Margin="0,6,0,14"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="ROM（12 桁の16進数）"/><TextBox x:Name="IdentityRom" Margin="0,6,0,14"/></StackPanel>
       <StackPanel Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Text="System UUID"/><TextBox x:Name="IdentityUuid" Margin="0,6,0,0"/></StackPanel>
      </Grid><WrapPanel Margin="0,20,0,0"><Button Content="識別情報を保存" Click="SaveIdentity" Style="{StaticResource PrimaryButton}"/><Button Content="現在の設定を読み込む" Click="LoadIdentityClick"/><Button Content="新しく生成…" Click="GenerateIdentity"/></WrapPanel>
      <TextBlock Text="Apple Account" Style="{StaticResource SectionHeading}"/><TextBlock Text="Tahoe 26.4 のサインイン互換設定を適用・解除できます。操作前に VM を完全終了してください。" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,16,0,0"><Button Content="互換設定を適用" Tag="EnableAppleAccount" Click="ActionClick"/><Button Content="互換設定を解除" Tag="DisableAppleAccount" Click="ActionClick"/></WrapPanel>
      <TextBlock Text="休止状態は使用しないでください。macOS 更新後は対応確認が必要です。" Style="{StaticResource MutedText}"/><Button Content="macOS の更新検出を修復" Tag="PrepareUpdates" Click="ActionClick" HorizontalAlignment="Left" Margin="0,18,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="スナップショット"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,20,20" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="状態を保存・復元" Style="{StaticResource PageHeading}"/><TextBlock Text="VM を完全終了してから保存します。復元しても現在のディスクは保持されます。" Style="{StaticResource MutedText}"/><TextBlock Text="保存する名前" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="保存" DockPanel.Dock="Right" Click="SaveSnapshot" Style="{StaticResource PrimaryButton}"/><TextBox x:Name="SnapshotName"/></DockPanel><TextBlock Text="保存済みの状態" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="復元…" DockPanel.Dock="Right" Click="RestoreSnapshot"/><ComboBox x:Name="Snapshots"/></DockPanel>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="セットアップ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,20,20" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="macOS をインストール" Style="{StaticResource PageHeading}"/><TextBlock Text="1  インストーラーを選択" Style="{StaticResource SectionHeading}"/><DockPanel><Button Content="ISO を選択…" DockPanel.Dock="Right" Click="BrowseIso"/><TextBox x:Name="Iso"/></DockPanel><TextBlock Text="2  ディスクを準備" Style="{StaticResource SectionHeading}"/><TextBlock Text="新規ディスクの容量 (GiB)" Margin="0,0,0,8"/><TextBox x:Name="NewDiskSize" Text="128" Width="160" HorizontalAlignment="Left"/><Button Content="ディスクと OpenCore を準備" Click="Setup" HorizontalAlignment="Left" Margin="0,16,0,16" Style="{StaticResource PrimaryButton}"/>
      <TextBlock Text="3  インストーラーから起動" Style="{StaticResource SectionHeading}"/><CheckBox x:Name="ConnectIso" Content="インストーラーを接続して起動" Margin="0,0,0,12"/><TextBlock Text="Disk Utility で仮想ディスクを APFS に初期化し、macOS をインストールします。初回設定後、REIMSTOOLS の setup.command を実行してください。" Style="{StaticResource MutedText}"/>
      <Expander Header="エンジンの準備" Margin="0,24,0,0"><WrapPanel Margin="0,12,0,0"><Button Content="エンジンを構築" Tag="BuildEngine" Click="ActionClick"/><Button Content="WHPX を有効化…" Click="EnableWhpx"/></WrapPanel></Expander>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="接続"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,20,20" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="macOS とペアリング" Style="{StaticResource PageHeading}"/><TextBlock Text="Finder の REIMSTOOLS から setup.command を開き、表示されたユーザー名と指紋を入力します。" Style="{StaticResource MutedText}"/><TextBlock Text="macOS ユーザー名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GuestUser"/><TextBlock Text="SHA256 指紋" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Fingerprint"/><Button Content="指紋を照合して接続" Click="Pair" HorizontalAlignment="Left" Margin="0,20,0,16" Style="{StaticResource PrimaryButton}"/><TextBlock Text="macOS のパスワードは保存しません。SSH 鍵はこの VM のフォルダーに保持します。" Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="ブリッジ"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8,24,20,20" MaxWidth="680" HorizontalAlignment="Stretch">
      <TextBlock Text="ブリッジ接続を準備" Style="{StaticResource PageHeading}"/><TextBlock Text="TAP-Windows6 と物理アダプターを接続します。通常のインターネット利用には NAT を使用できます。" Style="{StaticResource MutedText}"/><WrapPanel Margin="0,20,0,0"><Button Content="TAP をダウンロード" Click="TapDownload"/><Button Content="署名済み TAP を導入…" Click="InstallTap"/></WrapPanel><TextBlock Text="TAP アダプター" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BridgeTap"/><TextBlock Text="物理アダプター" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Physical"/><Button Content="ブリッジを作成…" Click="CreateBridge" HorizontalAlignment="Left" Margin="0,20,0,12"/><TextBlock Text="Windows の管理者権限が必要です。作成時はネットワーク接続が一時的に切れる場合があります。" Style="{StaticResource MutedText}"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Expander x:Name="OperationLog" Header="操作ログ" Grid.Row="3" Margin="0,16,0,0"><DockPanel Margin="0,10,0,0"><Button Content="診断ログを保存" Tag="CollectLogs" Click="ActionClick" DockPanel.Dock="Right" VerticalAlignment="Top"/><TextBox x:Name="Log" Height="110" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></DockPanel></Expander>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,1,0,0" Padding="18,8"><DockPanel><Button Content="保存先を開く" Click="RevealVm" DockPanel.Dock="Right" Padding="10,2" Margin="12,0,0,0"/><TextBlock x:Name="VmLocation" Text="VM ファイルを開くか、新規作成してください。" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>
